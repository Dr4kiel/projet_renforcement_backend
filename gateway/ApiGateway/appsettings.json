{
  "Cors": {
    "AllowedOrigins": "http://localhost:5173,http://localhost:3000"
  },
  "ReverseProxy": {
    "Routes": {
      "backoffice-route": {
        "ClusterId": "backoffice-cluster",
        "Match": {
          "Path": "/api/v1/{**catch-all}"
        }
      },
      "realtime-hubs-route": {
        "ClusterId": "realtime-cluster",
        "Match": {
          "Path": "/hubs/{**catch-all}"
        }
      },
      "realtime-health-route": {
        "ClusterId": "realtime-cluster",
        "Match": {
          "Path": "/realtime/health"
        },
        "Transforms": [
          { "PathPattern": "/health" }
        ]
      }
    },
    "Clusters": {
      "backoffice-cluster": {
        "Destinations": {
          "backoffice": {
            "Address": "http://backoffice:5001"
          }
        }
      },
      "realtime-cluster": {
        "Destinations": {
          "realtime": {
            "Address": "http://realtime:5002"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*"
}
