          "rawSql": "SELECT \n  e.equipment_id as \"ID\",\n  e.name as \"Nom Équipement\",\n  COUNT(DISTINCT et.tag_name) as \"Nombre de Tags\"\nFROM \"Equipments\" e\nLEFT JOIN \"Equipment_Tag\" et ON e.equipment_id = et.equipment\nGROUP BY e.equipment_id, e.name\nORDER BY e.equipment_id",
