          "rawSql": "SELECT \n  l.line_id as \"ID Ligne\",\n  l.name as \"Nom Ligne\",\n  e.name as \"Équipement\",\n  o.of_name as \"OF en cours\",\n  o.qte_totale as \"Quantité cible\"\nFROM \"Lines\" l\nLEFT JOIN \"Equipments\" e ON l.equipment = e.equipment_id\nLEFT JOIN ofs o ON l.of_en_cours = o.of_id\nORDER BY l.line_id",
