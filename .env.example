# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=production_dashboard
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# ── pgAdmin ───────────────────────────────────────────────────────────────────
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=8080

# ── Gateway (Traefik) ─────────────────────────────────────────────────────────
GATEWAY_PORT=5050
GATEWAY_DASHBOARD_PORT=5051

# ── Services (BackOffice & Realtime) ─────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=production-dashboard-super-secret-key-min-32-characters-long-2025

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:5050

# ── Agents ────────────────────────────────────────────────────────────────────
AGENT_INTERVAL=5.0
AGENT_PRODUCTION_INCREMENT=1
AGENT_CHANGEOVER_PROBABILITY=0
AGENT_CHANGEOVER_DURATION=30
AGENT_LOG_LEVEL=INFO
